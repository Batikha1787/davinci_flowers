#!/bin/bash
# Скрипт быстрого запуска сайта DaVinci Flowers
# Переходим в папку проекта
cd "$(dirname "$0")/.."

echo "=================================================="
echo "   Запуск сайта DaVinci Flowers и RAG-сервера...  "
echo "=================================================="

# Открываем сайт в браузере по умолчанию через 1 секунду
(sleep 1 && open "http://localhost:8000") &

# Запускаем сервер
python3 server.py
